#!/bin/sh
set -eu

umask 077

EXPECTED_LINEAGE="/etc/letsencrypt/live/{{ app_acme_cert_name }}"

if [ -z "${RENEWED_LINEAGE:-}" ]; then
    echo "RENEWED_LINEAGE is not set" >&2
    exit 1
fi

# This hook is installed in Certbot's global deploy-hook directory.
# Ignore certificates not owned by this role.
if [ "$RENEWED_LINEAGE" != "$EXPECTED_LINEAGE" ]; then
    exit 0
fi

DOCKER_BIN="$(command -v docker)"

CERT_SOURCE="${RENEWED_LINEAGE}/fullchain.pem"
KEY_SOURCE="${RENEWED_LINEAGE}/privkey.pem"

CERT_DEST="{{ app_acme_nginx_cert_dest }}"
KEY_DEST="{{ app_acme_nginx_key_dest }}"

COMPOSE_PROJECT_DIR="{{ app_acme_compose_project_dir }}"
NGINX_SERVICE="{{ app_acme_nginx_service }}"

if [ ! -r "$CERT_SOURCE" ] || [ ! -r "$KEY_SOURCE" ]; then
    echo "Certificate lineage is incomplete: $RENEWED_LINEAGE" >&2
    exit 1
fi

# Avoid unnecessary nginx reloads if the deployed certificate is already current.
if [ -f "$CERT_DEST" ] &&
   [ -f "$KEY_DEST" ] &&
   cmp -s "$CERT_SOURCE" "$CERT_DEST" &&
   cmp -s "$KEY_SOURCE" "$KEY_DEST"
then
    exit 0
fi

CERT_TMP="$(mktemp "${CERT_DEST}.tmp.XXXXXX")"
KEY_TMP="$(mktemp "${KEY_DEST}.tmp.XXXXXX")"

CERT_BACKUP="${CERT_DEST}.rollback.$$"
KEY_BACKUP="${KEY_DEST}.rollback.$$"

HAD_CERT=0
HAD_KEY=0

cleanup() {
    rm -f \
        "$CERT_TMP" \
        "$KEY_TMP" \
        "$CERT_BACKUP" \
        "$KEY_BACKUP"
}

restore_previous() {
    if [ "$HAD_CERT" -eq 1 ]; then
        mv -f "$CERT_BACKUP" "$CERT_DEST"
    else
        rm -f "$CERT_DEST"
    fi

    if [ "$HAD_KEY" -eq 1 ]; then
        mv -f "$KEY_BACKUP" "$KEY_DEST"
    else
        rm -f "$KEY_DEST"
    fi
}

trap cleanup EXIT HUP INT TERM

install -m 0644 "$CERT_SOURCE" "$CERT_TMP"
install -m 0600 "$KEY_SOURCE" "$KEY_TMP"

if [ -f "$CERT_DEST" ]; then
    cp -p "$CERT_DEST" "$CERT_BACKUP"
    HAD_CERT=1
fi

if [ -f "$KEY_DEST" ]; then
    cp -p "$KEY_DEST" "$KEY_BACKUP"
    HAD_KEY=1
fi

if ! mv -f "$CERT_TMP" "$CERT_DEST"; then
    restore_previous
    exit 1
fi

if ! mv -f "$KEY_TMP" "$KEY_DEST"; then
    restore_previous
    exit 1
fi

cd "$COMPOSE_PROJECT_DIR"

NGINX_CONTAINER_ID="$(
    "$DOCKER_BIN" compose ps --status running -q "$NGINX_SERVICE"
)"

if [ -n "$NGINX_CONTAINER_ID" ]; then
    if ! "$DOCKER_BIN" compose \
        exec -T "$NGINX_SERVICE" nginx -t
    then
        restore_previous
        echo "New certificate rejected by nginx configuration test" >&2
        exit 1
    fi

    if ! "$DOCKER_BIN" compose \
        exec -T "$NGINX_SERVICE" nginx -s reload
    then
        restore_previous

        "$DOCKER_BIN" compose \
            exec -T "$NGINX_SERVICE" nginx -t || true

        "$DOCKER_BIN" compose \
            exec -T "$NGINX_SERVICE" nginx -s reload || true

        echo "Nginx reload failed; previous certificate restored" >&2
        exit 1
    fi
fi
