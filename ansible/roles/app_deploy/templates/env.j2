DJANGO_SECRET_KEY='{{ vault_django_secret_key }}'
DJANGO_DEBUG={{ 'True' if app_django_debug else 'False' }}

DJANGO_ALLOWED_HOSTS={{ app_django_allowed_hosts | join(',') }}
DJANGO_CSRF_TRUSTED_ORIGINS={{ app_django_csrf_trusted_origins | join(',') }}

DJANGO_SECURE_SSL_REDIRECT={{ 'True' if app_django_secure_ssl_redirect else 'False' }}
DJANGO_SESSION_COOKIE_SECURE={{ 'True' if app_django_session_cookie_secure else 'False' }}
DJANGO_CSRF_COOKIE_SECURE={{ 'True' if app_django_csrf_cookie_secure else 'False' }}

DJANGO_SECURE_HSTS_SECONDS={{ app_django_secure_hsts_seconds }}
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS={{ 'True' if app_django_secure_hsts_include_subdomains else 'False' }}
DJANGO_SECURE_HSTS_PRELOAD={{ 'True' if app_django_secure_hsts_preload else 'False' }}

POSTGRES_DB={{ app_postgres_db }}
POSTGRES_USER={{ app_postgres_user }}
POSTGRES_PASSWORD='{{ vault_postgres_password }}'
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
